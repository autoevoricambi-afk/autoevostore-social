<section class="ae-s" id="{{ section.id }}">
  <div class="ae-wrap ae-wrap--narrow">
    <header class="ae-head">
      {%- if section.settings.kicker != blank -%}<p class="ae-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="ae-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="ae-sub">{{ section.settings.text }}</p>{%- endif -%}
    </header>
    <div class="ae-faq">
      {%- for block in section.blocks -%}
        <details class="ae-faq__i" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}</summary>
          <div class="ae-faq__a">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "AE Domande frequenti",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Sopratitolo", "default": "Prima di ordinare"},
    {"type": "text", "id": "heading", "label": "Titolo", "default": "Domande frequenti"},
    {"type": "textarea", "id": "text", "label": "Testo"}
  ],
  "blocks": [
    {"type": "question", "name": "Domanda", "settings": [
      {"type": "text", "id": "question", "label": "Domanda", "default": "Domanda"},
      {"type": "richtext", "id": "answer", "label": "Risposta", "default": "<p>Risposta.</p>"}
    ]}
  ],
  "presets": [{"name": "AE Domande frequenti", "blocks": [{"type": "question"}]}]
}
{% endschema %}
