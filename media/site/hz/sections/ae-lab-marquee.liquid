<section class="ae-s ae-brands" aria-label="{{ section.settings.heading | escape }}">
  <div class="ae-wrap">
    <p class="ae-kicker">{{ section.settings.heading }}</p>
  </div>
  <div class="ae-marq"><div class="ae-marq__t">
    {%- for n in (1..2) -%}
      <span class="ae-marq__g" {% if n == 2 %}aria-hidden="true"{% endif %}>
        {%- for block in section.blocks -%}
          <a href="{{ block.settings.link | default: '#' }}" {% if n == 2 %}tabindex="-1"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.name }}</a>
        {%- endfor -%}
      </span>
    {%- endfor -%}
  </div></div>
</section>
{% schema %}
{
  "name": "AE Marchi",
  "settings": [{"type": "text", "id": "heading", "label": "Titolo", "default": "Le marche che trattiamo"}],
  "blocks": [{"type": "brand", "name": "Marchio", "settings": [
    {"type": "text", "id": "name", "label": "Nome", "default": "Castrol"},
    {"type": "url", "id": "link", "label": "Link"}
  ]}],
  "presets": [{"name": "AE Marchi", "blocks": [{"type": "brand"}]}]
}
{% endschema %}
