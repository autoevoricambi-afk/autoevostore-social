<section class="ae-ring" id="{{ section.id }}" aria-roledescription="carosello 3D" aria-label="{{ section.settings.heading | escape }}">
  <div class="ae-ring__head">
    {%- if section.settings.kicker != blank -%}<p class="ae-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
    <h2 class="ae-h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="ae-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="ae-ring__stage">
    <div class="ae-ring__glow"></div>
    <div class="ae-ring__floor"></div>
    <div class="ae-ring__rot">
      {%- for block in section.blocks -%}
        {%- assign p = all_products[block.settings.product] -%}
        {%- if p != blank and p.available and block.settings.cutout != blank -%}
          <a class="ae-ring__it" href="{{ p.url }}" data-name="{{ block.settings.name | escape }}" data-sub="{{ block.settings.sub | escape }}" data-c="{{ block.settings.color }}" draggable="false" {{ block.shopify_attributes }}>
            <img src="{{ block.settings.cutout }}" alt="{{ p.title | escape }}" loading="lazy" decoding="async" draggable="false">
            <img class="rf" src="{{ block.settings.cutout }}" alt="" aria-hidden="true" loading="lazy" decoding="async" draggable="false">
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
  <div class="ae-ring__ui">
    <div class="ae-ring__cap" aria-live="polite"><b data-cap-n></b><span data-cap-s></span></div>
    <div class="ae-ring__cta">
      <button type="button" class="ae-ring__btn" data-prev aria-label="Precedente">←</button>
      <button type="button" class="ae-ring__btn" data-next aria-label="Successivo">→</button>
      <a class="ae-ring__go" data-go href="#">Vedi il prodotto</a>
    </div>
  </div>
  <p class="ae-ring__hint">Trascina per far girare la gamma</p>
</section>
<link rel="stylesheet" href="{{ 'ae-ring.css' | asset_url }}">
<script src="{{ 'ae-ring.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "AE Gamma 3D",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Sopratitolo", "default": "La gamma"},
    {"type": "text", "id": "heading", "label": "Titolo", "default": "Gira la gamma."},
    {"type": "textarea", "id": "subheading", "label": "Sottotitolo"}
  ],
  "blocks": [
    {
      "type": "bottle",
      "name": "Flacone",
      "settings": [
        {"type": "product", "id": "product", "label": "Prodotto (solo se disponibile)"},
        {"type": "text", "id": "name", "label": "Nome breve", "default": "Castrol EDGE"},
        {"type": "text", "id": "sub", "label": "Sottotitolo", "default": "5W-30"},
        {"type": "text", "id": "cutout", "label": "URL immagine ritagliata (PNG trasparente)"},
        {"type": "color", "id": "color", "label": "Colore luce", "default": "#1fbf75"}
      ]
    }
  ],
  "presets": [{"name": "AE Gamma 3D", "blocks": [{"type": "bottle"}, {"type": "bottle"}, {"type": "bottle"}]}]
}
{% endschema %}
