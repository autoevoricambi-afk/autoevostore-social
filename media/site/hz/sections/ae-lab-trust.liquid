<section class="ae-s ae-trust" aria-label="Servizio">
  <div class="ae-wrap">
    <ul class="ae-trust__list">
      {%- for block in section.blocks -%}
        <li class="ae-trust__item" {{ block.shopify_attributes }}>
          <span class="ae-ico" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg>
              {%- when 'shield' -%}<svg viewBox="0 0 24 24"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg>
              {%- when 'return' -%}<svg viewBox="0 0 24 24"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg>
              {%- when 'chat' -%}<svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg>
            {%- endcase -%}
          </span>
          <div><b>{{ block.settings.title }}</b><span>{{ block.settings.text }}</span></div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{% schema %}
{
  "name": "AE Servizio",
  "blocks": [
    {
      "type": "item",
      "name": "Voce",
      "settings": [
        {"type": "select", "id": "icon", "label": "Icona", "default": "truck", "options": [
          {"value": "truck", "label": "Spedizione"}, {"value": "shield", "label": "Originale"}, {"value": "return", "label": "Reso"}, {"value": "card", "label": "Pagamento"}, {"value": "chat", "label": "Assistenza"}]},
        {"type": "text", "id": "title", "label": "Titolo", "default": "Spedizione gratuita"},
        {"type": "text", "id": "text", "label": "Testo", "default": "In tutta Italia, 24/48 ore"}
      ]
    }
  ],
  "presets": [{"name": "AE Servizio", "blocks": [{"type": "item"}, {"type": "item"}, {"type": "item"}, {"type": "item"}]}]
}
{% endschema %}
