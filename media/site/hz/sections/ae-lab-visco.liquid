<section class="ae-visco" id="{{ section.id }}">
  <div class="ae-visco__wrap">
    <header class="ae-head">
      {%- if section.settings.kicker != blank -%}<p class="ae-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="ae-h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="ae-sub">{{ section.settings.subheading }}</p>{%- endif -%}
    </header>
    <div class="ae-visco__panel">
      <canvas class="ae-visco__cv" role="img" aria-label="Simulazione illustrativa: come scorrono oli di gradazione diversa al variare della temperatura"></canvas>
      <div hidden>{%- for block in section.blocks -%}<i data-grade="{{ block.settings.grade }}" {{ block.shopify_attributes }}></i>{%- endfor -%}</div>
      <div class="ae-visco__ctl">
        <div class="ae-visco__temp"><span data-temp>-10 °C</span><small>Temperatura</small></div>
        <input type="range" min="-20" max="100" step="1" value="-10" aria-label="Temperatura dell'olio">
        <div class="ae-visco__pre"><button type="button" data-pre="-20">Avviamento a freddo</button><button type="button" data-pre="90">Motore caldo</button></div>
      </div>
    </div>
    <p class="ae-visco__note">{{ section.settings.note }}</p>
  </div>
</section>
<link rel="stylesheet" href="{{ 'ae-visco.css' | asset_url }}">
<script src="{{ 'ae-visco.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "AE Simulatore viscosità",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Sopratitolo", "default": "Capire l'olio"},
    {"type": "text", "id": "heading", "label": "Titolo", "default": "Il numero davanti alla W"},
    {"type": "textarea", "id": "subheading", "label": "Sottotitolo"},
    {"type": "textarea", "id": "note", "label": "Nota"}
  ],
  "blocks": [
    {"type": "grade", "name": "Gradazione", "settings": [{"type": "text", "id": "grade", "label": "Gradazione (es. 5W-30)", "default": "5W-30"}]}
  ],
  "presets": [{"name": "AE Simulatore viscosità", "blocks": [{"type": "grade"}, {"type": "grade"}]}]
}
{% endschema %}
