{%- liquid
  assign lang = request.locale.iso_code
  assign visc = product.metafields.custom.viscosita.value
  assign tipo = product.metafields.custom.tipo_fluido.value
  assign first_title = product.variants.first.title | downcase | split: 'x'
  assign fmt = ''
  if first_title.size == 2
    assign fmt = first_title.last | upcase | replace: 'L', ' L'
  endif
  if lang == 'de'
    assign t_ship = 'Kostenloser Versand in Italien'
    assign d_ship = 'Lieferung in 24/48 Stunden mit BRT.'
    assign t_eu = 'Versand in Europa'
    assign d_eu = '3-7 Werktage (ohne Zypern und Malta).'
    assign t_orig = 'Originalprodukte'
    assign d_orig = 'Versiegelte Originalverpackung des Herstellers.'
    assign t_ret = 'Rückgabe innerhalb von 14 Tagen'
    assign d_ret = 'Bei unversehrten, ungeöffneten Produkten.'
    assign t_pay = 'Sichere Zahlung'
    assign t_wa = 'Passt es zu Ihrem Auto?'
    assign d_wa = 'Schreiben Sie uns Kennzeichen und Modell: wir prüfen die richtige Spezifikation.'
    assign t_det = 'Details'
    assign l_brand = 'Marke'
    assign l_type = 'Typ'
    assign l_grade = 'Viskosität'
    assign l_size = 'Einzelgröße'
  elsif lang == 'en'
    assign t_ship = 'Free shipping in Italy'
    assign d_ship = 'Delivered in 24/48 hours with BRT.'
    assign t_eu = 'Shipping across Europe'
    assign d_eu = '3-7 working days (excluding Cyprus and Malta).'
    assign t_orig = 'Original products'
    assign d_orig = 'Sealed, original manufacturer packaging.'
    assign t_ret = 'Returns within 14 days'
    assign d_ret = 'On intact, unopened products.'
    assign t_pay = 'Secure payment'
    assign t_wa = 'Does it fit your car?'
    assign d_wa = 'Send us plate and model: we check the right specification for you.'
    assign t_det = 'Details'
    assign l_brand = 'Brand'
    assign l_type = 'Type'
    assign l_grade = 'Grade'
    assign l_size = 'Single size'
  else
    assign t_ship = 'Spedizione gratuita in Italia'
    assign d_ship = 'Consegna in 24/48 ore con corriere BRT.'
    assign t_eu = 'Spedizione in Europa'
    assign d_eu = '3-7 giorni lavorativi (escluse Cipro e Malta).'
    assign t_orig = 'Prodotto originale'
    assign d_orig = 'Confezione originale sigillata del produttore.'
    assign t_ret = 'Reso entro 14 giorni'
    assign d_ret = 'Su prodotti integri e non aperti.'
    assign t_pay = 'Pagamento sicuro'
    assign t_wa = 'È adatto alla tua auto?'
    assign d_wa = 'Scrivici targa e modello in DM: verifichiamo noi la specifica giusta.'
    assign t_det = 'Dettagli'
    assign l_brand = 'Marchio'
    assign l_type = 'Tipo'
    assign l_grade = 'Gradazione'
    assign l_size = 'Formato singolo'
  endif
-%}
<div class="ae-pdp">
  <div class="ae-box">
    <ul class="ae-list">
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/></svg><div><b>{{ t_ship }}</b><span>{{ d_ship }}</span></div></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/></svg><div><b>{{ t_eu }}</b><span>{{ d_eu }}</span></div></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 4 6v6c0 4.4 3.4 8.2 8 9 4.6-.8 8-4.6 8-9V6z"/><path d="m8.5 12 2.5 2.5 4.5-5"/></svg><div><b>{{ t_orig }}</b><span>{{ d_orig }}</span></div></li>
      <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 14 4 9l5-5"/><path d="M4 9h10a6 6 0 0 1 0 12h-3"/></svg><div><b>{{ t_ret }}</b><span>{{ d_ret }}</span></div></li>
      {%- if shop.enabled_payment_types.size > 0 -%}
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/></svg><div><b>{{ t_pay }}</b>
          <span class="ae-pay">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag: class: 'ae-pay__icon' }}{%- endfor -%}</span></div></li>
      {%- endif -%}
    </ul>
  </div>
  <a class="ae-wa" href="https://wa.me/393923178180?text={{ 'Ciao, vorrei sapere se è adatto alla mia auto: ' | append: product.title | append: ' — ' | append: shop.url | append: product.url | url_encode }}" target="_blank" rel="noopener">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm4.5 12.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.8-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2s.2-1.1.1-1.2l-.5-.3Z"/></svg>
    <span><b>{{ t_wa }}</b><br>{{ d_wa }}</span>
  </a>
  <div class="ae-box">
    <p class="ae-box__t">{{ t_det }}</p>
    <table class="ae-spec"><tbody>
      <tr><th>{{ l_brand }}</th><td><a href="{{ routes.all_products_collection_url }}?filter.p.vendor={{ product.vendor | url_encode | replace: '+', '%20' }}">{{ product.vendor | escape }}</a></td></tr>
      {%- if tipo != blank -%}<tr><th>{{ l_type }}</th><td>{{ tipo | escape }}</td></tr>{%- endif -%}
      {%- if visc != blank -%}<tr><th>{{ l_grade }}</th><td><a href="{{ routes.all_products_collection_url }}?filter.p.m.custom.viscosita={{ visc | url_encode | replace: '+', '%20' }}">{{ visc | escape }}</a></td></tr>{%- endif -%}
      {%- if fmt != blank -%}<tr><th>{{ l_size }}</th><td>{{ fmt }}</td></tr>{%- endif -%}
    </tbody></table>
  </div>
</div>
